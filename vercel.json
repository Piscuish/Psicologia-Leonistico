{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(css|js|woff2|woff|ttf|png|jpg|jpeg|svg|webp|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin451200",
      "destination": "/admin.html"
    },
    {
      "source": "/2610",
      "destination": "/admin.html"
    },
    {
      "source": "/guia-bienestar",
      "destination": "/guia-bienestar.html"
    },
    {
      "source": "/encuentros",
      "destination": "/encuentros.html"
    },
    {
      "source": "/promocion-prevencion",
      "destination": "/promocion-prevencion.html"
    },
    {
      "source": "/promocion-y-prevencion",
      "destination": "/promocion-prevencion.html"
    },
    {
      "source": "/pagina/(.*)",
      "destination": "/pagina.html"
    },
    {
      "source": "/p/(.*)",
      "destination": "/pagina.html"
    },
    {
      "source": "/ciclos/(.*)",
      "destination": "/ciclos/template.html"
    }
  ]
}