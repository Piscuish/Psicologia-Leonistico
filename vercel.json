{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(css|js|woff2|woff|ttf|png|jpg|jpeg|svg|webp|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/ping",
      "destination": "/api/index.js"
    },
    {
      "source": "/keep-alive",
      "destination": "/api/index.js"
    },
    {
      "source": "/ciclos/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/pagina/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/p/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin451200",
      "destination": "/api/index.js"
    },
    {
      "source": "/2610",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|uploads/|.*\\..*).*)",
      "destination": "/api/index.js"
    }
  ]
}